# What must never reach a remote, first. The rest of this file is noise control;
# this block is the part whose failure is not recoverable — a pushed credential
# is a leaked credential even after a force-push, because the object stays in
# every fork and every clone that fetched it.
#
# scripts/publish-standalone.sh asserts the same patterns independently before it
# pushes. The duplication is deliberate: a stale .gitignore must not be able to
# leak a key into a published repository on its own.
.env
.env.*
!.env.example
*.key
*.pem
kubeconfig
.kube/

# ── Backend state ────────────────────────────────────────────────────────────
# SQLite database and its sibling encryption key. The key file is written next
# to the database on purpose (app/crypto.key_file_path), so a glob that catches
# one must catch the other — see the *.key rule above.
*.db
*.db-journal
*.db-wal
*.db-shm
k8boss_admin.db*
backend/data/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtualenvs, under every name people actually use.
venv/
.venv/
env/
ENV/
.python-version

# Test and type-checker caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
reports/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ── Playwright ───────────────────────────────────────────────────────────────
# playwright-report/ and test-results/ are regenerated by every run and contain
# full-page screenshots and traces of whatever fixture data the suite rendered.
playwright-report/
test-results/
blob-report/
.playwright/
playwright/.cache/

# ── Editors and operating systems ────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# /graphify output: a regenerable knowledge-graph artifact (graph.json,
# graph.html, GRAPH_REPORT.md, cache/), not a source change worth tracking.
graphify-out/
